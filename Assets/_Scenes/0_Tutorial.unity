  m_text: "\u042D\u0442\u043E\u0442 \u043C\u0438\u0440 \u2014 \u043D\u0435\u043A\u043E\u0433\u0434\u0430
    \u0436\u0438\u0432\u0430\u044F \u0438 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u2014 \"\u0441\u043F\u0438\u0442\"
    \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0433\u043E \u0437\u0430\u0431\u0432\u0435\u043D\u0438\u044F,
    \u0432\u044B\u0437\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u043C
    \u0441\u0432\u044F\u0437\u0438 \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u0438\u0440\u043E\u0434\u043E\u0439
    \u0438 \u0435\u0451 \u0434\u0443\u0445\u0430\u043C\u0438.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u043C\u0438\u0440\u0430, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0436\u0438\u0432\u0438\u0442\u044C \u0435\u0433\u043E."
